# 用途：本地监听、持久目录与浏览器使用的地址。
BLOG_ADDR=127.0.0.1:8888
BLOG_DATA_DIR=./data
BLOG_PUBLIC_URL=http://localhost:8888
BLOG_FRONTEND_URL=http://localhost:8080
BLOG_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081
BLOG_TIMEZONE=Asia/Shanghai
# 用途：选择已确认文件存储模式；默认本地，OSS仅显式启用。
BLOG_UPLOAD_MODE=local
BLOG_OSS_ENDPOINT=
BLOG_OSS_REGION=
BLOG_OSS_BUCKET=
BLOG_OSS_PUBLIC_URL=
BLOG_OSS_ACCESS_KEY_ID=
BLOG_OSS_ACCESS_KEY_SECRET=
# 用途：真实邮件提交与TLS，不携带任何默认凭据。
BLOG_SMTP_HOST=
BLOG_SMTP_PORT=
BLOG_SMTP_TLS_MODE=
BLOG_SMTP_USERNAME=
BLOG_SMTP_PASSWORD=
BLOG_SMTP_FROM=
# 用途：固定原身份提供方的应用核验资料。
BLOG_QQ_APP_ID=
BLOG_WEIBO_APP_KEY=
BLOG_WEIBO_APP_SECRET=
BLOG_WEIBO_REDIRECT_URI=
# 用途：显式启用原地区补充，缺省不发外部请求。
BLOG_IP_ENABLED=false
BLOG_IP_ENDPOINT=
